# Wazuh version
WAZUH_VERSION=4.14.5

# Docker network
SUBNET=172.20.0.0/16
GATEWAY=172.20.0.1

# --- Secretos — copiar a .env (gitignored) y completar con valores reales ---
# OpenSearch (wazuh-indexer): usuarios admin/kibanaserver de config/wazuh_indexer/internal_users.yml
INDEXER_PASSWORD=changeme
DASHBOARD_PASSWORD=changeme

# Wazuh Manager API (usuario wazuh-wui) — mínimo 8 caracteres, mayúscula, minúscula, número y símbolo
API_PASSWORD=changeme

# TheHive — API key del usuario de servicio (perfil analyst/prod1-thehive)
THEHIVE_API_KEY=changeme
